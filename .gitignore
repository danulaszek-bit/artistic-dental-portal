# Artistic Dental Portal - .gitignore
# ===================================
# Anything matched here will NEVER be committed to GitHub.

# === Secrets — never commit these ===
credentials.json
token.pickle
*.key
*.pem
.streamlit/secrets.toml

# === PHI / customer data — never commit these ===
cache/case_history.csv
case_files/
retention_periods/
live_exports/

# === Raw / large source data ===
*.xls
*.xlsx
sample_exports/
# Local staging for raw source files (payroll registers, materials + sales
# backfills). Payroll holds per-person compensation — never commit this folder.
# Do not rely on the *.xlsx rule above: a .csv export would otherwise slip in.
historical/

# === Logs ===
*.log
pipeline.log
retention_pipeline.log

# === Python ===
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.env

# === Editor / OS noise ===
.vscode/
.idea/
.DS_Store
Thumbs.db

# === Throwaway ZIPs / patches ===
dashboard_fix*.zip
*.tmp

# === Cache directories — only `cache/latest/` is committed ===
cache/snapshot_*/

# === Manager-portal user data (goals, PTO) — local only, not pipeline output ===
data/

# === Scratch / review folders ===
_scar_dash_review/
.claude/

# logistics push throttle state (local only)
.logistics_push_state
